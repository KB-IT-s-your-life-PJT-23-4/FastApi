MIRIZOOM_DB_USER=root
MIRIZOOM_DB_PASSWORD=your_password

OPENAI_EMBEDDING_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHROMA_PATH=storage/chroma

